# Supabase project settings (Project Settings > API).
# Leave these empty to run the compressor without the saved library.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Defaults to compressed-images, which the migration creates.
SUPABASE_BUCKET=compressed-images
